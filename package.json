{
  "name": "rotmgtradehub",
  "version": "0.1.0",
  "private": true,
  "description": "The rotmgtradenode hub: accounts, node registry, version feed, ban telemetry. No bots, no items, no credentials, no money.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --external:better-sqlite3 --external:hono --external:@hono/node-server --sourcemap --outfile=dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.1",
    "hono": "^4.13.5",
    "rotmgtradenode": "file:../rotmgtradenode"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild": true
  },
  "license": "MIT"
}
